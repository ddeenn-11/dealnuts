# Copy this file to .env.local for local dev (gitignored, never commit real
# values). In production these are set as Environment Variables in the
# Vercel project settings instead - this file is just documentation of what
# api/scan-tag.js and api/usage.js expect to find.

# Required for cloud-assisted tag scanning (api/scan-tag.js).
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for rate limiting, usage tracking, and the /api/usage endpoint.
# Set up via Vercel: Project -> Storage -> add a Redis integration
# (Marketplace -> Upstash). Vercel injects these automatically once the
# integration is connected to this project - you shouldn't need to copy
# values by hand except for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
